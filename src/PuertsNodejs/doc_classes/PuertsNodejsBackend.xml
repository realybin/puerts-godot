<?xml version="1.0" encoding="UTF-8" ?>
<class name="PuertsNodejsBackend" inherits="Resource">
	<brief_description>Selects Node.js.</brief_description>
	<description>Pass to PuertsEnvironment.initialize. Supports tick, inspector, low-memory notification, and termination.</description>
	<methods>
		<method name="get_backend_id" qualifiers="const">
			<return type="StringName" />
			<description>Returns the stable backend identifier.</description>
		</method>
		<method name="get_backend_name" qualifiers="const">
			<return type="String" />
			<description>Returns the display name.</description>
		</method>
		<method name="get_language_id" qualifiers="const">
			<return type="StringName" />
			<description>Returns the language identifier.</description>
		</method>
		<method name="_puerts_get_functions_ptr" qualifiers="const">
			<return type="int" />
			<description>Returns the internal function table address used by the core.</description>
		</method>
	</methods>
</class>